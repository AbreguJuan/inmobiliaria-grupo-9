@model inmobiliaria_grupo_9.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
}

<h1>Editar Inmueble</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="IdInmueble" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="IdTipoInmueble" class="control-label"></label>

        <select asp-for="IdTipoInmueble" class="form-control">
            <option value="">-- Seleccione un tipo --</option>

            @foreach (var tipo in ViewBag.Tipos)
            {
                <option value="@tipo.IdTipoInmueble" selected="@(tipo.IdTipoInmueble == Model.IdTipoInmueble)">
                    @tipo.Nombre
                </option>
            }
        </select>

        <span asp-validation-for="IdTipoInmueble" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Provincia"></label>
        <input asp-for="Provincia" class="form-control" />
        <span asp-validation-for="Provincia" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Localidad"></label>
        <input asp-for="Localidad" class="form-control" />
        <span asp-validation-for="Localidad" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Direccion"></label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="PrecioXDia"></label>
        <input asp-for="PrecioXDia" class="form-control" />
        <span asp-validation-for="PrecioXDia" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="MetrosCuadrados"></label>
        <input asp-for="MetrosCuadrados" class="form-control" />
        <span asp-validation-for="MetrosCuadrados" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="NroAmbientes"></label>
        <input asp-for="NroAmbientes" class="form-control" />
        <span asp-validation-for="NroAmbientes" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="NroBanios"></label>
        <input asp-for="NroBanios" class="form-control" />
        <span asp-validation-for="NroBanios" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="IdPropietario"></label>

        <select asp-for="IdPropietario" class="form-control">

            @foreach (var propietario in ViewBag.Propietarios)
            {
                <option value="@propietario.IdPropietario">
                    @propietario.Nombre @propietario.Apellido
                </option>
            }

        </select>

        <span asp-validation-for="IdPropietario" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Habilitado" class="form-check-input" />
        <label asp-for="Habilitado" class="form-check-label"></label>
    </div>

    <div class="form-group mb-3">
        <label class="control-label">Foto de portada</label>

        @if (!string.IsNullOrEmpty(Model.FotoPortada))
        {
            <div class="mb-2">
                <img src="@Model.FotoPortada" style="max-width:200px;" class="d-block" />
                <small class="text-muted">Foto actual — subí una nueva solo si querés reemplazarla</small>
            </div>
        }

        <input type="file" name="fotoPortada" class="form-control" accept="image/*" />
    </div>

    <div class="form-group mb-3">
        <label class="control-label">Fotos de galería (podés elegir varias)</label>
        <input type="file" name="fotosGaleria" class="form-control" accept="image/*" multiple />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}