@model IEnumerable<inmobiliaria_grupo_9.Models.Inmueble>
@{ ViewData["Title"] = "Inmuebles sin reservas"; }

<h1>Inmuebles sin reservas (últimos @ViewBag.Dias días)</h1>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="number" name="dias" class="form-control" style="width:150px" value="@ViewBag.Dias" />
    <button type="submit" class="btn btn-primary">Actualizar</button>
</form>

<table class="table table-striped">
    <thead><tr><th>Tipo</th><th>Dirección</th><th>Precio/día</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TipoDeInmueble?.Nombre</td>
                <td>@item.Direccion</td>
                <td>$@item.PrecioXDia</td>
            </tr>
        }
    </tbody>
</table>