@model inmobiliaria_grupo_9.Models.Inmueble

@{
    ViewData["Title"] = "Detalle del Inmueble";
}

<h1>Detalle del Inmueble</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Código
    </dt>
    <dd class="col-sm-9">
        @Model.IdInmueble
    </dd>

    <dt class="col-sm-3">
        Tipo
    </dt>
    <dd class="col-sm-9">
        @Model.TipoDeInmueble?.Nombre
    </dd>

    <dt class="col-sm-3">
        Provincia
    </dt>
    <dd class="col-sm-9">
        @Model.Provincia
    </dd>

    <dt class="col-sm-3">
        Localidad
    </dt>
    <dd class="col-sm-9">
        @Model.Localidad
    </dd>

    <dt class="col-sm-3">
        Dirección
    </dt>
    <dd class="col-sm-9">
        @Model.Direccion
    </dd>

    <dt class="col-sm-3">
        Precio por día
    </dt>
    <dd class="col-sm-9">
        $ @Model.PrecioXDia
    </dd>

    <dt class="col-sm-3">
        Metros cuadrados
    </dt>
    <dd class="col-sm-9">
        @Model.MetrosCuadrados
    </dd>

    <dt class="col-sm-3">
        Número de ambientes
    </dt>
    <dd class="col-sm-9">
        @Model.NroAmbientes
    </dd>

    <dt class="col-sm-3">
        Número de baños
    </dt>
    <dd class="col-sm-9">
        @Model.NroBanios
    </dd>

    <dt class="col-sm-3">
        Propietario
    </dt>
    <dd class="col-sm-9">
        @if (Model.Propietario != null)
        {
            @($"{Model.Propietario.Nombre} {Model.Propietario.Apellido}")
        }
    </dd>

    <dt class="col-sm-3">
        Estado
    </dt>
    <dd class="col-sm-9">
        @(Model.Habilitado ? "Habilitado" : "No habilitado")
    </dd>

    @if (!string.IsNullOrEmpty(Model.FotoPortada))
    {
        <img src="@Model.FotoPortada" style="max-width:400px;" class="mb-3" />
    }

    <h4>Galería</h4>
    <div class="row">
        @foreach (var img in Model.Imagenes)
        {
            <div class="col-md-3 mb-3">
                <img src="@img.Url" style="width:100%;height:150px;object-fit:cover;" />
                <form asp-action="EliminarImagen" method="post" class="mt-1">
                    <input type="hidden" name="idImagen" value="@img.IdImagen" />
                    <input type="hidden" name="idInmueble" value="@Model.IdInmueble" />
                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                </form>
            </div>
        }
    </div>

</dl>

<a asp-action="Edit" asp-route-id="@Model.IdInmueble" class="btn btn-warning">
    Editar
</a>

<a asp-action="Index" class="btn btn-secondary">
    Volver
</a>