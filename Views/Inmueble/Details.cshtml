@model inmobiliaria_grupo_9.Models.Inmueble

@{
    ViewData["Title"] = "Detalle del Inmueble";
}

<h1>Detalle del Inmueble</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Código
    </dt>
    <dd class="col-sm-9">
        @Model.IdInmueble
    </dd>

    <dt class="col-sm-3">
        Tipo
    </dt>
    <dd class="col-sm-9">
        @Model.TipoDeInmueble?.Nombre
    </dd>

    <dt class="col-sm-3">
        Provincia
    </dt>
    <dd class="col-sm-9">
        @Model.Provincia
    </dd>

    <dt class="col-sm-3">
        Localidad
    </dt>
    <dd class="col-sm-9">
        @Model.Localidad
    </dd>

    <dt class="col-sm-3">
        Dirección
    </dt>
    <dd class="col-sm-9">
        @Model.Direccion
    </dd>

    <dt class="col-sm-3">
        Precio por día
    </dt>
    <dd class="col-sm-9">
        $ @Model.PrecioXDia
    </dd>

    <dt class="col-sm-3">
        Metros cuadrados
    </dt>
    <dd class="col-sm-9">
        @Model.MetrosCuadrados
    </dd>

    <dt class="col-sm-3">
        Número de ambientes
    </dt>
    <dd class="col-sm-9">
        @Model.NroAmbientes
    </dd>

    <dt class="col-sm-3">
        Número de baños
    </dt>
    <dd class="col-sm-9">
        @Model.NroBanios
    </dd>
    <dt class="col-sm-3">
        Cupo
    </dt>
    <dd class="col-sm-9">
        @Model.Cupo
    </dd>
    <dt class="col-sm-3">
        Latitud
    </dt>
    <dd class="col-sm-9">
        @(Model.Latitud?.ToString() ?? "No especificada")
    </dd>
    <dt class="col-sm-3">
        Longitud
    </dt>
    <dd class="col-sm-9">
        @(Model.Longitud?.ToString() ?? "No especificada")
    </dd>
    <dt class="col-sm-3">
        Propietario
    </dt>
    <dd class="col-sm-9">
        @if (Model.Propietario != null)
        {
            @($"{Model.Propietario.Nombre} {Model.Propietario.Apellido}")
        }
    </dd>

    <dt class="col-sm-3">
        Estado
    </dt>

    <dd class="col-sm-9">
        @(Model.Habilitado ? "Habilitado" : "No habilitado")
    </dd>

    @if (!string.IsNullOrEmpty(Model.FotoPortada))
    {
        <img src="@Model.FotoPortada" style="max-width:400px;" class="mb-3" />
    }

    <h4>Galería</h4>
    <div class="row">
        @foreach (var img in Model.Imagenes)
        {
            <div class="col-md-3 mb-3">
                <img src="@img.Url" style="width:100%;height:150px;object-fit:cover;" />
                <form asp-action="EliminarImagen" method="post" class="mt-1">
                    <input type="hidden" name="idImagen" value="@img.IdImagen" />
                    <input type="hidden" name="idInmueble" value="@Model.IdInmueble" />
                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                </form>
            </div>
        }
    </div>

    <h4 class="mt-4">Calendario de disponibilidad</h4>
    <div class="d-flex align-items-center mb-2">
        <button type="button" id="btnMesAnterior" class="btn btn-sm btn-outline-secondary">&laquo; Anterior</button>
        <span id="tituloMes" class="mx-3 fw-bold"></span>
        <button type="button" id="btnMesSiguiente" class="btn btn-sm btn-outline-secondary">Siguiente &raquo;</button>
    </div>
    <div class="mb-2">
        <span class="badge bg-danger">&nbsp;&nbsp;</span> Ocupado
        <span class="badge bg-success ms-3">&nbsp;&nbsp;</span> Disponible
    </div>
    <table class="table table-bordered text-center" id="calendario">
        <thead>
            <tr>
                <th>Dom</th>
                <th>Lun</th>
                <th>Mar</th>
                <th>Mié</th>
                <th>Jue</th>
                <th>Vie</th>
                <th>Sáb</th>
            </tr>
        </thead>
        <tbody id="cuerpoCalendario"></tbody>
    </table>

    <script>
            const rangosOcupados = @Html.Raw(ViewBag.RangosOcupados ?? "[]");

            let fechaActual = new Date();
            fechaActual.setDate(1);

            function estaOcupado(fecha) {
                const f = fecha.toISOString().split('T')[0];
                return rangosOcupados.some(r => f >= r.desde && f < r.hasta);
            }

            function renderCalendario() {
                const anio = fechaActual.getFullYear();
                const mes = fechaActual.getMonth();
                const nombresMes = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

                document.getElementById('tituloMes').textContent = `${nombresMes[mes]} ${anio}`;

                const primerDia = new Date(anio, mes, 1);
                const ultimoDia = new Date(anio, mes + 1, 0);
                const cuerpo = document.getElementById('cuerpoCalendario');
                cuerpo.innerHTML = '';

                let fila = document.createElement('tr');
                for (let i = 0; i < primerDia.getDay(); i++) {
                    fila.appendChild(document.createElement('td'));
                }

                for (let dia = 1; dia <= ultimoDia.getDate(); dia++) {
                    const fecha = new Date(anio, mes, dia);
                    const celda = document.createElement('td');
                    celda.textContent = dia;
                    celda.classList.add(estaOcupado(fecha) ? 'bg-danger' : 'bg-success');
                    celda.classList.add('text-white');
                    fila.appendChild(celda);

                    if (fecha.getDay() === 6 || dia === ultimoDia.getDate()) {
                        cuerpo.appendChild(fila);
                        fila = document.createElement('tr');
                    }
                }
            }

            document.getElementById('btnMesAnterior').addEventListener('click', () => {
                fechaActual.setMonth(fechaActual.getMonth() - 1);
                renderCalendario();
            });

            document.getElementById('btnMesSiguiente').addEventListener('click', () => {
                fechaActual.setMonth(fechaActual.getMonth() + 1);
                renderCalendario();
            });

            renderCalendario();
    </script>

</dl>

<a asp-action="Edit" asp-route-id="@Model.IdInmueble" class="btn btn-warning">
    Editar
</a>

<a asp-action="Index" class="btn btn-secondary">
    Volver
</a>