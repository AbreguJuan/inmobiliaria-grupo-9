@model inmobiliaria_grupo_9.Models.TipoDeInmueble

@{
    ViewData["Title"] = "Detalle del Tipo de Inmueble";
}

<h1>Detalle del Tipo de Inmueble</h1>

<dl class="row">
    <dt class="col-sm-2">Código</dt>
    <dd class="col-sm-10">@Model.IdTipoInmueble</dd>

    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Habilitado</dt>
    <dd class="col-sm-10">@(Model.Habilitado ? "Sí" : "No")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.IdTipoInmueble" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>