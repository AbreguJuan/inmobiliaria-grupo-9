@model inmobiliaria_grupo_9.Models.TipoDeInmueble

@{
    ViewData["Title"] = "Eliminar Tipo de Inmueble";
    int enUso = ViewBag.EnUso ?? 0;
}

<h1>¿Eliminar este tipo de inmueble?</h1>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Habilitado</dt>
    <dd class="col-sm-10">@(Model.Habilitado ? "Sí" : "No")</dd>
</dl>

@if (enUso > 0)
{
    <div class="alert alert-warning">
        Hay @enUso inmueble(s) usando este tipo, así que no se puede eliminar.
        Podés desmarcar "Habilitado" desde Editar para que deje de ofrecerse en los formularios.
    </div>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
}
else
{
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdTipoInmueble" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
}