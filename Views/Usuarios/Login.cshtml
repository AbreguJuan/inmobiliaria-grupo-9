@model inmobiliaria_grupo_9.Models.LoginView

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h4 class="mb-0">Acceso al Sistema</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Usuario" class="control-label fw-bold"></label>
                        <input asp-for="Usuario" class="form-control" placeholder="correo@ejemplo.com" autofocus />
                        <span asp-validation-for="Usuario" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Clave" class="control-label fw-bold">Contraseña</label>
                        <input asp-for="Clave" class="form-control" type="password" placeholder="Tu contraseña" />
                        <span asp-validation-for="Clave" class="text-danger"></span>
                    </div>

                    <div class="form-group text-center d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Ingresar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}