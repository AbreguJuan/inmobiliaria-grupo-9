@model IEnumerable<inmobiliaria_grupo_9.Models.Usuario>

@{
    ViewData["Title"] = "Lista de Usuarios";
    var rnd = new Random();
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-4">
    <h1>Usuarios del Sistema</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Nuevo Usuario
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.IdUsuario)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Nombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Apellido)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Email)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Avatar)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Rol)
                </th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr class="align-middle">
                <td>
                    @Html.DisplayFor(modelItem => item.IdUsuario)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Apellido)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @if(!String.IsNullOrEmpty(item.Avatar)) 
                    {
                        var x = item.Avatar + "?" + rnd.Next();
                        <img width="40" height="40" src="@x" class="rounded-circle border" style="object-fit: cover;" alt="Foto de perfil" />
                    }
                    else 
                    {
                        <img width="40" height="40" src="https://ui-avatars.com/api/?background=random&color=fff&rounded=true&name=@item.Nombre+@item.Apellido" alt="Avatar automático" />
                    }
                </td>
                <td>
                    <span class="badge bg-info text-dark">@Html.DisplayFor(modelItem => item.RolNombre)</span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-warning" title="Editar">
                        <i class="fa-solid fa-pen"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-danger" title="Eliminar">
                        <i class="fa-solid fa-trash-can"></i>
                    </a>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>