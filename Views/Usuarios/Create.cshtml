@model inmobiliaria_grupo_9.Models.Usuario

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fa-solid fa-user-plus"></i> Crear Nuevo Usuario</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nombre" class="control-label fw-bold"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Apellido" class="control-label fw-bold"></label>
                            <input asp-for="Apellido" class="form-control" placeholder="Ej: Pérez" />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="control-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Clave" class="control-label fw-bold"></label>
                        <input asp-for="Clave" class="form-control" type="password" placeholder="Contraseña segura" />
                        <span asp-validation-for="Clave" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AvatarFile" class="control-label fw-bold">Foto de Perfil (Opcional)</label>
                        <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="AvatarFile" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Rol" class="control-label fw-bold">Rol del Sistema</label>
                        <select asp-for="Rol" class="form-select">
                            <option value="">Seleccione un rol...</option>
                            @foreach (var kvp in (IDictionary<int, string>)ViewBag.Roles)
                            {
                                <option value="@kvp.Key">@kvp.Value</option>
                            }
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left"></i> Volver a la lista
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Guardar Usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}