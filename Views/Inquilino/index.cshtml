@model IEnumerable<inmobiliaria_grupo_9.Models.Inquilino>

@{
    ViewData["Title"] = "Inquilinos";
}

<h1>Inquilinos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Inquilino</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>DNI</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdInquilino</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.Dni</td>
                <td>@item.Telefono</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdInquilino">Detalles</a> |
                    <a asp-action="Edit" asp-route-id="@item.IdInquilino">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdInquilino">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>