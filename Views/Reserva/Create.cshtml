@model inmobiliaria_grupo_9.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
}

<h1>Nueva Reserva</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3 position-relative">
        <label>Inquilino</label>
        <input type="text" id="inputInquilino" class="form-control" placeholder="Escribí nombre, apellido o DNI..."
               autocomplete="off" />
        <input type="hidden" asp-for="IdInquilino" id="hiddenInquilino" />
        <ul id="listaInquilino" class="list-group position-absolute w-100" style="z-index:1000; display:none;"></ul>
        <span asp-validation-for="IdInquilino" class="text-danger"></span>
    </div>

    <div class="form-group mb-3 position-relative">
        <label>Inmueble</label>
        <input type="text" id="inputInmueble" class="form-control" placeholder="Escribí dirección o tipo..."
               autocomplete="off" />
        <input type="hidden" asp-for="IdInmueble" id="hiddenInmueble" />
        <ul id="listaInmueble" class="list-group position-absolute w-100" style="z-index:1000; display:none;"></ul>
        <span asp-validation-for="IdInmueble" class="text-danger"></span>
    </div>

    @section Scripts {
        <script src="~/js/autocomplete.js"></script>
        <script>
                initAutocomplete('inputInquilino', 'hiddenInquilino', 'listaInquilino', '@Url.Action("BuscarJson", "Inquilino")');
                initAutocomplete('inputInmueble', 'hiddenInmueble', 'listaInmueble', '@Url.Action("BuscarJson", "Inmueble")');
        </script>
    }

    <div class="form-group">
        <label asp-for="Desde"></label>
        <input asp-for="Desde" class="form-control" />
        <span asp-validation-for="Desde" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Hasta"></label>
        <input asp-for="Hasta" class="form-control" />
        <span asp-validation-for="Hasta" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>