@model IEnumerable<inmobiliaria_grupo_9.Models.Reserva>
@{ ViewData["Title"] = "Reservas por vencer"; }

<h1>Reservas que vencen en los próximos @ViewBag.Dias días</h1>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="number" name="dias" class="form-control" style="width:150px" value="@ViewBag.Dias" />
    <button type="submit" class="btn btn-primary">Actualizar</button>
</form>

<table class="table table-striped">
    <thead><tr><th>Inquilino</th><th>Inmueble</th><th>Vence</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Inquilino?.Nombre @item.Inquilino?.Apellido</td>
                <td>@item.Inmueble?.TipoDeInmueble?.Nombre - @item.Inmueble?.Direccion</td>
                <td>@item.Hasta.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>