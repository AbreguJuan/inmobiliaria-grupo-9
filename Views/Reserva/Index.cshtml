@model IEnumerable<inmobiliaria_grupo_9.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
}

<h1>Reservas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Reserva</a>
</p>

<p>
    <a asp-action="MasReservados" class="btn btn-outline-secondary btn-sm">Más reservados</a>
    <a asp-action="Vigentes" class="btn btn-outline-secondary btn-sm">Vigentes</a>
    <a asp-action="PorVencer" class="btn btn-outline-secondary btn-sm">Por vencer</a>
    <a asp-controller="Inmueble" asp-action="SinReservas" class="btn btn-outline-secondary btn-sm">Inmuebles sin reservas</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Inquilino</label>
            <input type="text" name="inquilino" class="form-control" value="@ViewBag.Inquilino" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Inmueble (dirección o tipo)</label>
            <input type="text" name="inmueble" class="form-control" value="@ViewBag.Inmueble" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Desde</label>
            <input type="date" name="fechaDesde" class="form-control"
                   value="@(ViewBag.FechaDesde != null ? ((DateTime)ViewBag.FechaDesde).ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Hasta</label>
            <input type="date" name="fechaHasta" class="form-control"
                   value="@(ViewBag.FechaHasta != null ? ((DateTime)ViewBag.FechaHasta).ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Estado</label>
            <select name="finalizadaFiltro" class="form-control">
                <option value="">Todos</option>
                <option value="vigentes" selected="@(ViewBag.FinalizadaFiltro == "vigentes")">Vigentes</option>
                <option value="finalizadas" selected="@(ViewBag.FinalizadaFiltro == "finalizadas")">Finalizadas</option>
            </select>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Buscar</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Limpiar</a>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Inquilino</th>
            <th>Inmueble</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdReserva</td>

                <td>
                    @if (item.Inquilino != null)
                    {
                        @($"{item.Inquilino.Nombre} {item.Inquilino.Apellido}")
                    }
                </td>

                <td>
                    @if (item.Inmueble != null)
                    {
                        @($"{item.Inmueble.TipoDeInmueble?.Nombre} - {item.Inmueble.Direccion}")
                    }
                </td>

                <td>@item.Desde.ToShortDateString()</td>
                <td>@item.Hasta.ToShortDateString()</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.IdReserva">Detalles</a> |

                    <a asp-action="Edit"
                       asp-route-id="@item.IdReserva">Editar</a> |
                       
                    <a asp-controller="Pago"
                       asp-action="PorReserva"
                       asp-route-idReserva="@item.IdReserva">Ver pagos</a> |

                    <a asp-controller="Pago"
                       asp-action="Create"
                       asp-route-idReserva="@item.IdReserva">Agregar pago</a>

                    @if (User.IsInRole("Administrador"))
                    {
                        <span> | </span>
                        <a asp-action="Delete"
                           asp-route-id="@item.IdReserva">Eliminar</a>
                    }

                    @if (!item.Finalizada)
                    {
                        <span> | </span>
                        <a asp-action="Renovar"
                           asp-route-id="@item.IdReserva">Renovar</a>

                        <span> | </span>
                        <a asp-action="Finalizar"
                           asp-route-id="@item.IdReserva">Finalizar</a>
                    }
                    else
                    {
                        <span> | Finalizada</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (totalPaginas > 1)
{
    <nav>
        <ul class="pagination">

            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(paginaActual - 1)">
                    Anterior
                </a>
            </li>

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(paginaActual + 1)">
                    Siguiente
                </a>
            </li>

        </ul>
    </nav>
}