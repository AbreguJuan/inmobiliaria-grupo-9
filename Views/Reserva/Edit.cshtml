@model inmobiliaria_grupo_9.Models.Reserva

@{
    ViewData["Title"] = "Editar Reserva";
}

<h1>Editar Reserva</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdReserva" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="IdInquilino"></label>
        <select asp-for="IdInquilino" asp-items="ViewBag.Inquilinos" class="form-control"></select>
        <span asp-validation-for="IdInquilino" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IdInmueble"></label>
        <select asp-for="IdInmueble" asp-items="ViewBag.Inmuebles" class="form-control"></select>
        <span asp-validation-for="IdInmueble" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Desde"></label>
        <input asp-for="Desde" class="form-control" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="Desde" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Hasta"></label>
        <input asp-for="Hasta" class="form-control" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="Hasta" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>