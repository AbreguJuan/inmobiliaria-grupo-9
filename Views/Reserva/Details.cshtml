@model inmobiliaria_grupo_9.Models.Reserva

@{
    ViewData["Title"] = "Detalle de la Reserva";
}

<h1>Detalle de la Reserva</h1>

<dl class="row">
    <dt class="col-sm-2">Inquilino (ID)</dt>
    <dd class="col-sm-10">@Model.IdInquilino</dd>

    <dt class="col-sm-2">Inmueble (ID)</dt>
    <dd class="col-sm-10">@Model.IdInmueble</dd>

    <dt class="col-sm-2">Desde</dt>
    <dd class="col-sm-10">@Model.Desde.ToShortDateString()</dd>

    <dt class="col-sm-2">Hasta</dt>
    <dd class="col-sm-10">@Model.Hasta.ToShortDateString()</dd>
</dl>

@* --- INICIO AUDITORÍA (SOLO VISIBLE PARA ADMINISTRADOR) --- *@
@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
{
    <div class="card border-info mb-4 mt-3">
        <div class="card-header bg-info text-white fw-bold">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                 class="bi bi-shield-lock me-2" viewBox="0 0 16 16">
                <path
                d="M5.338 1.59a59.768 59.768 0 0 0-2.836.856.801.801 0 0 0-.328.39c-.554 1.614-.726 3.432-.465 5.273.3 2.122 1.23 4.234 3.292 6.062 1.606 1.425 3.737 2.453 5.372 2.766a.8.8 0 0 0 .546-.07c1.635-.313 3.766-1.34 5.372-2.766 2.062-1.828 2.992-3.94 3.292-6.062.261-1.841.089-3.659-.465-5.273a.8.8 0 0 0-.328-.39 59.768 59.768 0 0 0-2.836-.856A1.8 1.8 0 0 0 8 1z" />
                <path
                d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99a1.5 1.5 0 1 1 2-1.415z" />
            </svg>
            Auditoría Interna
        </div>
        <div class="card-body bg-light">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-muted border-bottom pb-1">Creación de la Reserva</h6>
                    <p class="mb-1 text-sm">
                        <dt class="col-sm-2">Creado por</dt>
                        <dd class="col-sm-10">@(Model.Creador != null ? $"{Model.Creador.Nombre} {Model.Creador.Apellido}" :
                                                                    "—")</dd>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted border-bottom pb-1">Finalización</h6>
                        <p class="mb-1 text-sm">
                            <dt class="col-sm-2">Terminado por</dt>
                            <dd class="col-sm-10">@(Model.Terminador != null ? $"{Model.Terminador.Nombre} {Model.Terminador.Apellido}" : "—")</dd>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    @* --- FIN AUDITORÍA --- *@

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.IdReserva" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>