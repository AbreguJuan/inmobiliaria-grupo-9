@model IEnumerable<inmobiliaria_grupo_9.Models.Pago>

@{
    ViewData["Title"] = "Pagos";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
}

@if (string.IsNullOrWhiteSpace((string)ViewBag.Concepto) &&
     ViewBag.ImporteMin == null && ViewBag.ImporteMax == null &&
     ViewBag.FechaDesde == null && ViewBag.FechaHasta == null &&
     string.IsNullOrWhiteSpace((string)ViewBag.AnuladoFiltro) &&
     string.IsNullOrWhiteSpace((string)ViewBag.Inquilino) &&
     (int)ViewBag.TotalPaginas > 1)
{
    @* tu bloque de paginación actual va acá *@
}

<h1>Pagos</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Concepto</label>
            <input type="text" name="concepto" class="form-control" value="@ViewBag.Concepto" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Inquilino</label>
            <input type="text" name="inquilino" class="form-control" value="@ViewBag.Inquilino" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Desde $</label>
            <input type="number" step="0.01" name="importeMin" class="form-control" value="@ViewBag.ImporteMin" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Hasta $</label>
            <input type="number" step="0.01" name="importeMax" class="form-control" value="@ViewBag.ImporteMax" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Fecha desde</label>
            <input type="date" name="fechaDesde" class="form-control"
                   value="@(ViewBag.FechaDesde != null ? ((DateTime)ViewBag.FechaDesde).ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Fecha hasta</label>
            <input type="date" name="fechaHasta" class="form-control"
                   value="@(ViewBag.FechaHasta != null ? ((DateTime)ViewBag.FechaHasta).ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Estado</label>
            <select name="anuladoFiltro" class="form-control">
                <option value="">Todos</option>
                <option value="vigentes" selected="@(ViewBag.AnuladoFiltro == "vigentes")">Vigentes</option>
                <option value="anulados" selected="@(ViewBag.AnuladoFiltro == "anulados")">Anulados</option>
            </select>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Buscar</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Limpiar</a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Reserva</th>
            <th>Concepto</th>
            <th>Fecha</th>
            <th>Importe</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdPago</td>

                <td>
                    @if (item.Reserva?.Inquilino != null)
                    {
                        @($"{item.Reserva.Inquilino.Nombre} {item.Reserva.Inquilino.Apellido}")
                    }
                    else
                    {
                        <span>Sin datos</span>
                    }
                </td>

                <td>@item.Concepto</td>
                <td>@item.FechaPago.ToString("dd/MM/yyyy")</td>
                <td>$ @item.Importe</td>

                <td>
                    @if (item.Anulado)
                    {
                        <span>Anulado</span>
                    }
                    else
                    {
                        <span>Activo</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdPago">
                        Editar
                    </a>

                    <span> | </span>

                    <a asp-action="Details" asp-route-id="@item.IdPago">
                        Detalles
                    </a>

                    @if (!item.Anulado)
                    {
                        <span> | </span>

                        <a asp-action="Delete" asp-route-id="@item.IdPago">
                            Anular
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (totalPaginas > 1)
{
    <nav>
        <ul class="pagination">

            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)">
                    Anterior
                </a>
            </li>

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)">
                    Siguiente
                </a>
            </li>

        </ul>
    </nav>
}