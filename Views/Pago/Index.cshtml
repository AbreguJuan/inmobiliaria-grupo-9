@model IEnumerable<inmobiliaria_grupo_9.Models.Pago>

@{
    ViewData["Title"] = "Pagos";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
}

<h1>Pagos</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Reserva</th>
            <th>Concepto</th>
            <th>Fecha</th>
            <th>Importe</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdPago</td>

                <td>
                    @if (item.Reserva?.Inquilino != null)
                    {
                        @($"{item.Reserva.Inquilino.Nombre} {item.Reserva.Inquilino.Apellido}")
                    }
                    else
                    {
                        <span>Sin datos</span>
                    }
                </td>

                <td>@item.Concepto</td>
                <td>@item.FechaPago.ToString("dd/MM/yyyy")</td>
                <td>$ @item.Importe</td>

                <td>
                    @if (item.Anulado)
                    {
                        <span>Anulado</span>
                    }
                    else
                    {
                        <span>Activo</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.IdPago">
                        Editar
                    </a>

                    <span> | </span>

                    <a asp-action="Details"
                       asp-route-id="@item.IdPago">
                        Detalles
                    </a>

                    @if (!item.Anulado)
                    {
                        <span> | </span>

                        <a asp-action="Delete"
                           asp-route-id="@item.IdPago">
                            Anular
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (totalPaginas > 1)
{
    <nav>
        <ul class="pagination">

            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(paginaActual - 1)">
                    Anterior
                </a>
            </li>

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(paginaActual + 1)">
                    Siguiente
                </a>
            </li>

        </ul>
    </nav>
}