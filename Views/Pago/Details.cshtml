@model inmobiliaria_grupo_9.Models.Pago

@{
    ViewData["Title"] = "Detalle del Pago";
}

<h1>Detalle del Pago</h1>

<dl class="row">
    <dt class="col-sm-2">ID Pago</dt>
    <dd class="col-sm-10">@Model.IdPago</dd>

    <dt class="col-sm-2">Reserva Asociada</dt>
    <dd class="col-sm-10">@Model.IdReserva</dd>

    <dt class="col-sm-2">Concepto</dt>
    <dd class="col-sm-10">@Model.Concepto</dd>

    <dt class="col-sm-2">Fecha de Pago</dt>
    <dd class="col-sm-10">@Model.FechaPago.ToShortDateString()</dd>

    <dt class="col-sm-2">Importe</dt>
    <dd class="col-sm-10">$@Model.Importe</dd>

    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10">
        @if(Model.Anulado)
        {
            <span class="badge bg-danger">Anulado</span>
        }
        else
        {
            <span class="badge bg-success">Vigente</span>
        }
    </dd>
</dl>

@* --- INICIO AUDITORÍA (SOLO VISIBLE PARA ADMINISTRADOR) --- *@
@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
{
    <div class="card border-info mb-4 mt-3">
        <div class="card-header bg-info text-white fw-bold">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-shield-lock me-2" viewBox="0 0 16 16">
                <path d="M5.338 1.59a59.768 59.768 0 0 0-2.836.856.801.801 0 0 0-.328.39c-.554 1.614-.726 3.432-.465 5.273.3 2.122 1.23 4.234 3.292 6.062 1.606 1.425 3.737 2.453 5.372 2.766a.8.8 0 0 0 .546-.07c1.635-.313 3.766-1.34 5.372-2.766 2.062-1.828 2.992-3.94 3.292-6.062.261-1.841.089-3.659-.465-5.273a.8.8 0 0 0-.328-.39 59.768 59.768 0 0 0-2.836-.856A1.8 1.8 0 0 0 8 1z"/>
                <path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99a1.5 1.5 0 1 1 2-1.415z"/>
            </svg>
            Auditoría Interna
        </div>
        <div class="card-body bg-light">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-muted border-bottom pb-1">Creación del Pago</h6>
                    <p class="mb-1 text-sm">
                        <strong>Creado por:</strong> 
                        @(Model.Creador != null ? $"{Model.Creador.Nombre} {Model.Creador.Apellido}" : "Sistema/Desconocido")
                    </p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted border-bottom pb-1">Anulación</h6>
                    <p class="mb-1 text-sm">
                        <strong>Anulado por:</strong> 
                        @(Model.Anulador != null ? $"{Model.Anulador.Nombre} {Model.Anulador.Apellido}" : "No anulado")
                    </p>
                </div>
            </div>
        </div>
    </div>
}
@* --- FIN AUDITORÍA --- *@

<div class="mt-3">
    @if (!Model.Anulado)
    {
        <a asp-action="Edit" asp-route-id="@Model.IdPago" class="btn btn-primary">Editar</a>
    }
    <a href="javascript:history.back()" class="btn btn-secondary">Volver al listado</a>
</div>