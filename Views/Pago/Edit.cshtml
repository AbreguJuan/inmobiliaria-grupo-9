@model inmobiliaria_grupo_9.Models.Pago

@{
    ViewData["Title"] = "Editar Pago";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="fa-solid fa-pen-to-square"></i> Editar Concepto del Pago</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <input type="hidden" asp-for="IdPago" />

                    <div class="mb-3">
                        <label asp-for="Concepto" class="control-label fw-bold"></label>
                        <input asp-for="Concepto" class="form-control" />
                        <span asp-validation-for="Concepto" class="text-danger"></span>
                        <small class="text-muted">Es el único campo que se puede modificar.</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="control-label fw-bold">Fecha de Pago</label>
                            <input type="text" class="form-control bg-light" value="@Model.FechaPago.ToString("dd/MM/yyyy")" readonly disabled />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="control-label fw-bold">Importe</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" class="form-control bg-light" value="@Model.Importe" readonly disabled />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-warning fw-bold">
                            <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>