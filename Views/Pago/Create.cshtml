@model inmobiliaria_grupo_9.Models.Pago

@{
    ViewData["Title"] = "Nuevo Pago";
}

<h1>Nuevo Pago</h1>

<form asp-action="Create" method="post">

    <input type="hidden" asp-for="IdReserva" />

    <div class="mb-3">
        <label asp-for="IdReserva" class="form-label">Reserva</label>
        <input asp-for="IdReserva" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Concepto" class="form-label"></label>
        <input asp-for="Concepto" class="form-control" />
        <span asp-validation-for="Concepto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaPago" class="form-label"></label>
        <input asp-for="FechaPago" type="datetime-local" class="form-control" />
        <span asp-validation-for="FechaPago" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Importe" class="form-label"></label>
        <input asp-for="Importe" class="form-control" />
        <span asp-validation-for="Importe" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</form>