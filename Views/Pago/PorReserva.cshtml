@model IEnumerable<inmobiliaria_grupo_9.Models.Pago>

@{
    ViewData["Title"] = "Pagos de la Reserva";
}

<h1>Pagos de la Reserva @ViewBag.IdReserva</h1>

<p>
    <a asp-controller="Pago"
       asp-action="Create"
       asp-route-idReserva="@ViewBag.IdReserva">Agregar pago</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Concepto</th>
            <th>Fecha</th>
            <th>Importe</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdPago</td>

                <td>@item.Concepto</td>

                <td>@item.FechaPago.ToString("dd/MM/yyyy")</td>

                <td>$ @item.Importe.ToString("0.00")</td>

                <td>
                    @if (item.Anulado)
                    {
                        <span>Anulado</span>
                    }
                    else
                    {
                        <span>Activo</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.IdPago">Editar</a>

                    @if (!item.Anulado)
                    {
                        <span> | </span>

                        <a asp-action="Delete"
                           asp-route-id="@item.IdPago">Anular</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<p>
    <a asp-controller="Reserva"
       asp-action="Index">Volver a Reservas</a>
</p>