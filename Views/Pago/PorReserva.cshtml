@model IEnumerable<inmobiliaria_grupo_9.Models.Pago>

@{
    ViewData["Title"] = "Pagos de la Reserva";
}

<h1>Pagos de la Reserva @ViewBag.IdReserva</h1>

<div class="card mb-4">
    <div class="card-header">
        <strong>Resumen de la reserva</strong>
    </div>

    <div class="card-body">

        <p>
            <strong>Total de la reserva:</strong>
            $ @(((decimal)ViewBag.TotalReserva).ToString("0.00"))
        </p>

        <p>
            <strong>
                Seña requerida
                (@(((decimal)ViewBag.PorcentajeReserva).ToString("0.##"))%):
            </strong>
            $ @(((decimal)ViewBag.ImporteSenia).ToString("0.00"))
        </p>

        <p>
            <strong>Total pagado:</strong>
            $ @(((decimal)ViewBag.TotalPagado).ToString("0.00"))
        </p>

        <p>
            <strong>Saldo pendiente:</strong>
            $ @(((decimal)ViewBag.SaldoPendiente).ToString("0.00"))
        </p>

    </div>
</div>

<p>
    <a asp-controller="Pago"
       asp-action="Create"
       asp-route-idReserva="@ViewBag.IdReserva"
       class="btn btn-primary">
        Agregar pago
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Concepto</th>
            <th>Fecha</th>
            <th>Importe</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center">
                    No hay pagos registrados para esta reserva.
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdPago</td>

                    <td>@item.Concepto</td>

                    <td>
                        @item.FechaPago.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        $ @item.Importe.ToString("0.00")
                    </td>

                    <td>
                        @if (item.Anulado)
                        {
                            <span class="text-danger">
                                Anulado
                            </span>
                        }
                        else
                        {
                            <span class="text-success">
                                Activo
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.IdPago">
                            Editar
                        </a>

                        <span> | </span>

                        <a asp-action="Details"
                           asp-route-id="@item.IdPago">
                            Detalles
                        </a>

                        @if (!item.Anulado)
                        {
                            <span> | </span>

                            <a asp-action="Delete"
                               asp-route-id="@item.IdPago">
                                Anular
                            </a>
                        }
                    </td>
                </tr>
            }
        }

    </tbody>
</table>

<p>
    <a asp-controller="Reserva"
       asp-action="Index"
       class="btn btn-secondary">
        Volver a Reservas
    </a>
</p>